#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

COMMAND="${1:-build}"

check_typst() {
  if ! command -v typst >/dev/null 2>&1; then
    echo "Error: 'typst' binary not found in PATH." >&2
    echo "Please ensure typst is installed (e.g. ~/.local/bin/typst)." >&2
    exit 1
  fi
}

case "$COMMAND" in
  build)
    check_typst
    echo "⚡ Compiling slides.yaml -> slides.pdf..."
    start_time=$(date +%s%N)
    typst compile slides.typ slides.pdf
    end_time=$(date +%s%N)
    elapsed_ms=$(( (end_time - start_time) / 1000000 ))
    echo "✓ Generated slides.pdf in ${elapsed_ms}ms"
    ;;

  watch)
    check_typst
    echo "👀 Watching slides.yaml & template for changes (Ctrl+C to stop)..."
    typst watch slides.typ slides.pdf
    ;;

  export-images)
    check_typst
    OUT_DIR="${2:-dist/slides}"
    mkdir -p "$OUT_DIR"
    echo "🖼  Exporting slide images to ${OUT_DIR}/..."
    typst compile --format png slides.typ "${OUT_DIR}/slide-{n}.png"
    count=$(ls -1 "${OUT_DIR}"/slide-*.png 2>/dev/null | wc -l)
    echo "✓ Exported ${count} slides to ${OUT_DIR}/"
    ;;

  help|--help|-h)
    echo "Usage: ./slide-maker [command]"
    echo ""
    echo "Commands:"
    echo "  build            Compile slides.yaml to slides.pdf (default)"
    echo "  watch            Auto-recompile on every edit to slides.yaml"
    echo "  export-images    Render each slide as PNG (default: dist/slides/)"
    echo "  help             Show this help message"
    ;;

  *)
    echo "Unknown command: $COMMAND" >&2
    echo "Run './slide-maker help' for usage." >&2
    exit 1
    ;;
esac
