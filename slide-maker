#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

COMMAND="${1:-build}"

check_typst() {
  if ! command -v typst >/dev/null 2>&1; then
    echo "Error: 'typst' binary not found in PATH." >&2
    echo "Please ensure typst is installed (e.g. ~/.local/bin/typst)." >&2
    exit 1
  fi
}

case "$COMMAND" in
  build)
    check_typst
    echo "⚡ Compiling slides.yaml -> slides.pdf..."
    start_time=$(date +%s%N)
    if ! typst compile slides.typ slides.pdf; then
      echo "" >&2
      echo "✗ Typst compilation failed!" >&2
      echo "Tip: Run './slide-maker check' or check slides.yaml for invalid YAML or unescaped characters." >&2
      exit 1
    fi
    end_time=$(date +%s%N)
    elapsed_ms=$(( (end_time - start_time) / 1000000 ))
    echo "✓ Generated slides.pdf in ${elapsed_ms}ms"
    if command -v pdfinfo >/dev/null 2>&1; then
      pdfinfo slides.pdf | grep -E "^(Pages|Page size):" | sed 's/^/  • /' || true
    fi
    ;;

  paste)
    shift || true
    check_typst
    python3 "$SCRIPT_DIR/scripts/builder.py" "$@"
    ;;

  check)
    shift || true
    python3 -c "
import sys, yaml
from pathlib import Path
try:
    data = yaml.safe_load(Path('slides.yaml').read_text())
    print('✓ slides.yaml syntax is valid.')
    print(f'  • Title: {data.get(\"meta\", {}).get(\"title\", \"Untitled\")}')
    print(f'  • Total Slides: {len(data.get(\"slides\", []))}')
except Exception as e:
    print(f'✗ Validation error in slides.yaml:\n{e}', file=sys.stderr)
    sys.exit(1)
"
    ;;

  watch)
    check_typst
    echo "👀 Watching slides.yaml & template for changes (Ctrl+C to stop)..."
    typst watch slides.typ slides.pdf
    ;;

  export-images)
    check_typst
    OUT_DIR="${2:-dist/slides}"
    mkdir -p "$OUT_DIR"
    echo "🖼  Exporting slide images to ${OUT_DIR}/..."
    typst compile --format png slides.typ "${OUT_DIR}/slide-{n}.png"
    count=$(ls -1 "${OUT_DIR}"/slide-*.png 2>/dev/null | wc -l)
    echo "✓ Exported ${count} slides to ${OUT_DIR}/"
    ;;

  export-pptx)
    OUT_FILE="${2:-slides.pptx}"
    PYTHON_CMD="python3"
    if [ -f "$SCRIPT_DIR/.venv/bin/python" ]; then
      PYTHON_CMD="$SCRIPT_DIR/.venv/bin/python"
    fi
    $PYTHON_CMD "$SCRIPT_DIR/scripts/export_pptx.py" "$OUT_FILE"
    ;;

  help|--help|-h)
    echo "Usage: ./slide-maker [command]"
    echo ""
    echo "Commands:"
    echo "  paste [--clipboard|-c]   Paste YAML/LLM output directly to auto-validate & build"
    echo "  build                    Compile slides.yaml to slides.pdf (default)"
    echo "  check                    Validate syntax and structure of slides.yaml"
    echo "  watch                    Auto-recompile on every edit to slides.yaml"
    echo "  export-images [dir]      Render each slide as PNG (default: dist/slides/)"
    echo "  export-pptx [file.pptx]  Export to native editable PowerPoint deck (default: slides.pptx)"
    echo "  help                     Show this help message"
    echo ""
    echo "Examples:"
    echo "  ./slide-maker paste                 # Paste directly in terminal, press Ctrl+D"
    echo "  ./slide-maker paste -c              # Instantly build from system clipboard"
    echo "  cat my_deck.yaml | ./slide-maker paste"
    ;;

  *)
    echo "Unknown command: $COMMAND" >&2
    echo "Run './slide-maker help' for usage." >&2
    exit 1
    ;;
esac
